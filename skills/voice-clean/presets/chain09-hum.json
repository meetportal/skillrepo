{
  "name": "chain09-hum",
  "description": "chain09 with narrow notches on the mains fundamental and three harmonics. Use when diagnose reports hum peaks 6 dB or more above their neighbours. Set hum_hz to 50 or 60.",
  "params": {
    "hum_hz": 50,
    "hum_harmonics": 4,
    "hum_q": 20,
    "hum_cut_db": -30,
    "highpass_hz": 80,
    "afftdn_nr": 10,
    "afftdn_nf": -58,
    "lowmid_hz": 250,
    "lowmid_gain_db": -2,
    "presence_hz": 3500,
    "presence_gain_db": 2.5,
    "deess_i": 0.5,
    "comp_threshold_db": -22,
    "comp_ratio": 3,
    "gate_threshold": 0.003,
    "gate_range": 0.25
  },
  "stages": [
    {"hum_notch": {"fundamental_hz": "{hum_hz}", "harmonics": "{hum_harmonics}", "q": "{hum_q}", "gain_db": "{hum_cut_db}"}},
    "highpass=f={highpass_hz}:poles=2",
    "afftdn=nr={afftdn_nr}:nf={afftdn_nf}:tn=1",
    "equalizer=f={lowmid_hz}:t=q:w=1.0:g={lowmid_gain_db}",
    "equalizer=f={presence_hz}:t=q:w=1.2:g={presence_gain_db}",
    "deesser=i={deess_i}:m=0.5:f=0.5:s=o",
    "acompressor=threshold={comp_threshold_db}dB:ratio={comp_ratio}:attack=5:release=90:makeup=1:knee=4",
    "agate=threshold={gate_threshold}:ratio=2:range={gate_range}:attack=5:release=150"
  ]
}
