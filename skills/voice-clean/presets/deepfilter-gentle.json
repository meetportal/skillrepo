{
  "name": "deepfilter-gentle",
  "description": "DeepFilterNet3 with an attenuation limit in place of afftdn, then the chain09 tone, de-ess and compression. For steady broadband noise (fans, HVAC, street hum) where afftdn leaves a floor. Needs the deep-filter binary.",
  "params": {
    "highpass_hz": 80,
    "df_atten_db": 18,
    "lowmid_hz": 250,
    "lowmid_gain_db": -2,
    "presence_hz": 3500,
    "presence_gain_db": 2.5,
    "deess_i": 0.5,
    "comp_threshold_db": -22,
    "comp_ratio": 3
  },
  "stages": [
    "highpass=f={highpass_hz}:poles=2",
    {"deepfilter": {"atten_lim_db": "{df_atten_db}"}},
    "equalizer=f={lowmid_hz}:t=q:w=1.0:g={lowmid_gain_db}",
    "equalizer=f={presence_hz}:t=q:w=1.2:g={presence_gain_db}",
    "deesser=i={deess_i}:m=0.5:f=0.5:s=o",
    "acompressor=threshold={comp_threshold_db}dB:ratio={comp_ratio}:attack=5:release=90:makeup=1:knee=4"
  ]
}
