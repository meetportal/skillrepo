{
  "name": "dialogue-df",
  "description": "dialogue with DeepFilterNet3 capped at a 10 dB attenuation limit in front. For broadband or slowly changing noise where afftdn adds musical noise. Needs the deep-filter binary. Ends with a 4x oversampled look-ahead peak limiter that holds true peak 14 dB above the mono voice loudness (11 dB once the mix plays it as dual mono).",
  "params": {
    "highpass_hz": 80,
    "lowmid_hz": 250,
    "lowmid_gain_db": -2,
    "presence_hz": 3500,
    "presence_gain_db": 2.5,
    "deess_i": 0.4,
    "deess_f": 1.0,
    "comp_threshold_db": -14,
    "comp_ratio": 2,
    "expander_threshold_db": -45,
    "expander_ratio": 3,
    "expander_range": 0.5,
    "expander_release_ms": 50,
    "df_atten_db": 10,
    "peak_plr_db": 14,
    "peak_attack_ms": 3,
    "peak_release_ms": 50
  },
  "stages": [
    "highpass=f={highpass_hz}:poles=2",
    {
      "deepfilter": {
        "atten_lim_db": "{df_atten_db}",
        "post_filter": false
      }
    },
    "equalizer=f={lowmid_hz}:t=q:w=1.0:g={lowmid_gain_db}",
    "equalizer=f={presence_hz}:t=q:w=1.2:g={presence_gain_db}",
    "deesser=i={deess_i}:m=0.5:f={deess_f}:s=o",
    "agate=threshold={expander_threshold_db}dB:ratio={expander_ratio}:range={expander_range}:knee=6:attack=5:release={expander_release_ms}:detection=rms",
    "acompressor=threshold={comp_threshold_db}dB:ratio={comp_ratio}:attack=10:release=150:makeup=1:knee=6",
    {
      "peak_limit": {
        "plr_db": "{peak_plr_db}",
        "attack_ms": "{peak_attack_ms}",
        "release_ms": "{peak_release_ms}"
      }
    }
  ]
}
